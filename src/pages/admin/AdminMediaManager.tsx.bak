import React, { useState, useEffect } from 'react';
import { useAdminAuth } from '../../context/AdminAuthContext';
import { listDriveFiles, DriveFile } from '../../services/googleDriveService';

export const AdminMediaManager: React.FC = () => {
  const { driveToken, connectGoogleDrive } = useAdminAuth();
  const [files, setFiles] = useState<DriveFile[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [fileTypeFilter, setFileTypeFilter] = useState<'all' | 'image' | 'pdf'>('all');
  const [copiedId, setCopiedId] = useState<string | null>(null);
  const [previewFile, setPreviewFile] = useState<DriveFile | null>(null);

  const fetchFiles = async (query = '', type = fileTypeFilter) => {
    if (!driveToken) return;
    try {
      setLoading(true);
      setError(null);
      const mime =
        type === 'image' ? 'image/' : type === 'pdf' ? 'application/pdf' : undefined;
      const results = await listDriveFiles(driveToken, {
        searchQuery: query || undefined,
        mimeType: mime,
        pageSize: 40,
      });
      setFiles(results);
    } catch (err: any) {
      console.error('Error fetching Drive files:', err);
      setError(err?.message || 'Failed to fetch files from Google Drive.');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (driveToken) {
      fetchFiles(searchQuery, fileTypeFilter);
    }
  }, [driveToken, fileTypeFilter]);

  const handleSearchSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    fetchFiles(searchQuery, fileTypeFilter);
  };

  const copyToClipboard = (text: string, id: string) => {
    navigator.clipboard.writeText(text);
    setCopiedId(id);
    setTimeout(() => setCopiedId(null), 2000);
  };

  const formatFileSize = (bytes?: string) => {
    if (!bytes) return 'Unknown size';
    const num = parseInt(bytes, 10);
    if (isNaN(num)) return 'Unknown size';
    if (num < 1024) return `${num} B`;
    if (num < 1024 * 1024) return `${(num / 1024).toFixed(1)} KB`;
    return `${(num / (1024 * 1024)).toFixed(1)} MB`;
  };

  return (
    <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
      {/* Header */}
      <div
        style={{
          display: 'flex',
          flexWrap: 'wrap',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: '16px',
          marginBottom: '24px',
        }}
      >
        <div>
          <h1 style={{ fontSize: '1.75rem', fontWeight: 700, margin: '0 0 6px 0', color: '#fff' }}>
            Google Drive Media Assets
          </h1>
          <p style={{ margin: 0, color: '#a1a1aa', fontSize: '0.9rem' }}>
            Browse and manage certificate images, project screenshots, and resume PDFs directly from your Google Drive.
          </p>
        </div>

        <div style={{ display: 'flex', gap: '10px' }}>
          {driveToken ? (
            <button
              type="button"
              onClick={() => fetchFiles(searchQuery, fileTypeFilter)}
              disabled={loading}
              style={{
                display: 'inline-flex',
                alignItems: 'center',
                gap: '8px',
                padding: '9px 16px',
                backgroundColor: '#27272a',
                border: '1px solid #3f3f46',
                borderRadius: '8px',
                color: '#fff',
                fontSize: '0.85rem',
                cursor: loading ? 'not-allowed' : 'pointer',
              }}
            >
              <i className={`fas fa-sync-alt ${loading ? 'fa-spin' : ''}`}></i>
              Refresh
            </button>
          ) : (
            <button
              type="button"
              onClick={() => connectGoogleDrive()}
              style={{
                display: 'inline-flex',
                alignItems: 'center',
                gap: '8px',
                padding: '10px 18px',
                backgroundColor: '#2563eb',
                border: 'none',
                borderRadius: '8px',
                color: '#fff',
                fontWeight: 600,
                fontSize: '0.9rem',
                cursor: 'pointer',
              }}
            >
              <i className="fab fa-google-drive"></i>
              Connect Google Drive
            </button>
          )}
        </div>
      </div>

      {/* Connection Notice / Drive Status */}
      {!driveToken ? (
        <div
          style={{
            backgroundColor: '#18181b',
            border: '1px solid #3f3f46',
            borderRadius: '12px',
            padding: '36px',
            textAlign: 'center',
            marginBottom: '32px',
          }}
        >
          <div
            style={{
              width: '60px',
              height: '60px',
              borderRadius: '50%',
              backgroundColor: 'rgba(37, 99, 235, 0.15)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              margin: '0 auto 16px',
              color: '#3b82f6',
              fontSize: '28px',
            }}
          >
            <i className="fab fa-google-drive"></i>
          </div>
          <h2 style={{ fontSize: '1.25rem', fontWeight: 600, color: '#fff', marginBottom: '8px' }}>
            Connect Your Google Drive
          </h2>
          <p style={{ color: '#a1a1aa', maxWidth: '520px', margin: '0 auto 20px', fontSize: '0.9rem', lineHeight: 1.5 }}>
            Access all your portfolio certificate scans, event photography, project mockups, and resume documents with read-only OAuth permissions.
          </p>
          <button
            type="button"
            onClick={() => connectGoogleDrive()}
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: '8px',
              padding: '12px 24px',
              backgroundColor: '#2563eb',
              border: 'none',
              borderRadius: '8px',
              color: '#fff',
              fontWeight: 600,
              fontSize: '0.95rem',
              cursor: 'pointer',
              marginBottom: '20px',
            }}
          >
            <i className="fab fa-google-drive"></i>
            Authorize Google Drive Access
          </button>

          {/* Google Verification Warning Explainer */}
          <div
            style={{
              maxWidth: '560px',
              margin: '0 auto',
              padding: '14px 18px',
              backgroundColor: 'rgba(59, 130, 246, 0.08)',
              border: '1px solid rgba(59, 130, 246, 0.25)',
              borderRadius: '10px',
              textAlign: 'left',
              fontSize: '0.82rem',
              color: '#93c5fd',
              lineHeight: 1.5,
            }}
          >
            <div style={{ fontWeight: 600, color: '#60a5fa', marginBottom: '4px' }}>
              <i className="fas fa-shield-alt" style={{ marginRight: '6px' }}></i>
              Google Cloud Testing Notice (&ldquo;Google hasn&apos;t verified this app&rdquo;)
            </div>
            During developer testing, Google shows an unverified app screen because the app is in test mode. When the Google popup opens:
            <ol style={{ margin: '6px 0 0 0', paddingLeft: '20px' }}>
              <li>Click <strong>&ldquo;Advanced&rdquo;</strong> (small link at bottom left).</li>
              <li>Click <strong>&ldquo;Go to Mayur Portfolio (unsafe)&rdquo;</strong>.</li>
              <li>Check the permissions box and click <strong>&ldquo;Continue&rdquo;</strong>.</li>
            </ol>
            Only your authorized administrator Google account (<code>mayurhr57@gmail.com</code>) has access.
          </div>
        </div>
      ) : (
        <>
          {/* Search & Filter Bar */}
          <div
            style={{
              display: 'flex',
              flexWrap: 'wrap',
              gap: '12px',
              alignItems: 'center',
              justifyContent: 'space-between',
              backgroundColor: '#18181b',
              padding: '16px 20px',
              borderRadius: '12px',
              border: '1px solid #27272a',
              marginBottom: '24px',
            }}
          >
            <form onSubmit={handleSearchSubmit} style={{ display: 'flex', gap: '8px', flex: 1, minWidth: '260px' }}>
              <div style={{ position: 'relative', flex: 1 }}>
                <i
                  className="fas fa-search"
                  style={{
                    position: 'absolute',
                    left: '12px',
                    top: '50%',
                    transform: 'translateY(-50%)',
                    color: '#71717a',
                    fontSize: '14px',
                  }}
                ></i>
                <input
                  type="text"
                  placeholder="Search files by name..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  style={{
                    width: '100%',
                    padding: '9px 12px 9px 36px',
                    backgroundColor: '#121214',
                    border: '1px solid #27272a',
                    borderRadius: '8px',
                    color: '#fff',
                    fontSize: '0.88rem',
                    outline: 'none',
                  }}
                />
              </div>
              <button
                type="submit"
                style={{
                  padding: '9px 16px',
                  backgroundColor: '#2563eb',
                  border: 'none',
                  borderRadius: '8px',
                  color: '#fff',
                  fontSize: '0.85rem',
                  fontWeight: 600,
                  cursor: 'pointer',
                }}
              >
                Search
              </button>
            </form>

            {/* Type Filter Buttons */}
            <div style={{ display: 'flex', gap: '6px' }}>
              {(['all', 'image', 'pdf'] as const).map((t) => (
                <button
                  key={t}
                  type="button"
                  onClick={() => setFileTypeFilter(t)}
                  style={{
                    padding: '8px 14px',
                    borderRadius: '6px',
                    border: '1px solid',
                    borderColor: fileTypeFilter === t ? '#3b82f6' : '#27272a',
                    backgroundColor: fileTypeFilter === t ? 'rgba(59, 130, 246, 0.15)' : '#121214',
                    color: fileTypeFilter === t ? '#60a5fa' : '#a1a1aa',
                    fontSize: '0.82rem',
                    fontWeight: 500,
                    textTransform: 'capitalize',
                    cursor: 'pointer',
                  }}
                >
                  {t === 'all' ? 'All Files' : t === 'image' ? 'Images' : 'PDFs'}
                </button>
              ))}
            </div>
          </div>

          {/* Drive Sharing Tip */}
          <div
            style={{
              display: 'flex',
              alignItems: 'flex-start',
              gap: '12px',
              padding: '12px 16px',
              backgroundColor: 'rgba(234, 179, 8, 0.08)',
              border: '1px solid rgba(234, 179, 8, 0.25)',
              borderRadius: '8px',
              marginBottom: '24px',
              fontSize: '0.85rem',
              color: '#fef08a',
            }}
          >
            <i className="fas fa-lightbulb" style={{ color: '#eab308', marginTop: '2px' }}></i>
            <div>
              <strong>Public Portfolio Visibility Note:</strong> Google Drive files used in certificates and projects must have their sharing setting set to <em>"Anyone with the link can view"</em> in Google Drive so portfolio visitors can see the images and PDFs without being prompted to log in.
            </div>
          </div>

          {/* Error Message */}
          {error && (
            <div
              style={{
                padding: '14px 18px',
                backgroundColor: 'rgba(239, 68, 68, 0.12)',
                border: '1px solid rgba(239, 68, 68, 0.3)',
                borderRadius: '8px',
                color: '#f87171',
                marginBottom: '20px',
                fontSize: '0.88rem',
              }}
            >
              {error}
            </div>
          )}

          {/* File Grid */}
          {loading ? (
            <div style={{ textAlign: 'center', padding: '60px 0', color: '#a1a1aa' }}>
              <i className="fas fa-spinner fa-spin" style={{ fontSize: '32px', color: '#3b82f6', marginBottom: '14px' }}></i>
              <div>Loading files from Google Drive...</div>
            </div>
          ) : files.length === 0 ? (
            <div
              style={{
                backgroundColor: '#18181b',
                border: '1px dashed #27272a',
                borderRadius: '12px',
                padding: '48px 24px',
                textAlign: 'center',
                color: '#71717a',
              }}
            >
              <i className="fas fa-folder-open" style={{ fontSize: '36px', marginBottom: '12px', color: '#3f3f46' }}></i>
              <div style={{ fontSize: '1rem', fontWeight: 600, color: '#d4d4d8', marginBottom: '4px' }}>
                No files found
              </div>
              <p style={{ margin: 0, fontSize: '0.85rem' }}>
                Try adjusting your search query or file type filter.
              </p>
            </div>
          ) : (
            <div
              style={{
                display: 'grid',
                gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))',
                gap: '16px',
              }}
            >
              {files.map((file) => {
                const isImage = file.mimeType.startsWith('image/');
                const isPdf = file.mimeType === 'application/pdf';

                return (
                  <div
                    key={file.id}
                    style={{
                      backgroundColor: '#18181b',
                      borderRadius: '10px',
                      border: '1px solid #27272a',
                      overflow: 'hidden',
                      display: 'flex',
                      flexDirection: 'column',
                      transition: 'border-color 0.15s ease',
                    }}
                  >
                    {/* Thumbnail / Preview Area */}
                    <div
                      style={{
                        height: '140px',
                        backgroundColor: '#121214',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        position: 'relative',
                        overflow: 'hidden',
                      }}
                    >
                      {file.thumbnailLink ? (
                        <img
                          src={file.thumbnailLink}
                          alt={file.name}
                          style={{ width: '100%', height: '100%', objectFit: 'cover' }}
                        />
                      ) : (
                        <div style={{ textAlign: 'center', color: '#52525b' }}>
                          <i
                            className={
                              isImage
                                ? 'fas fa-file-image'
                                : isPdf
                                ? 'fas fa-file-pdf'
                                : 'fas fa-file'
                            }
                            style={{
                              fontSize: '36px',
                              color: isPdf ? '#ef4444' : isImage ? '#3b82f6' : '#71717a',
                            }}
                          ></i>
                        </div>
                      )}

                      {/* Preview Button */}
                      <button
                        type="button"
                        onClick={() => setPreviewFile(file)}
                        style={{
                          position: 'absolute',
                          top: '8px',
                          right: '8px',
                          padding: '6px 8px',
                          backgroundColor: 'rgba(0,0,0,0.7)',
                          border: 'none',
                          borderRadius: '6px',
                          color: '#fff',
                          fontSize: '11px',
                          cursor: 'pointer',
                        }}
                        title="Preview File"
                      >
                        <i className="fas fa-eye"></i>
                      </button>
                    </div>

                    {/* Metadata */}
                    <div style={{ padding: '14px', flex: 1, display: 'flex', flexDirection: 'column' }}>
                      <div
                        title={file.name}
                        style={{
                          fontWeight: 600,
                          fontSize: '0.88rem',
                          color: '#f4f4f5',
                          overflow: 'hidden',
                          textOverflow: 'ellipsis',
                          whiteSpace: 'nowrap',
                          marginBottom: '6px',
                        }}
                      >
                        {file.name}
                      </div>

                      <div
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'space-between',
                          fontSize: '0.75rem',
                          color: '#71717a',
                          marginBottom: '12px',
                        }}
                      >
                        <span>{formatFileSize(file.size)}</span>
                        <span
                          style={{
                            padding: '2px 6px',
                            backgroundColor: '#27272a',
                            borderRadius: '4px',
                            color: '#a1a1aa',
                          }}
                        >
                          {isPdf ? 'PDF' : isImage ? 'Image' : 'File'}
                        </span>
                      </div>

                      {/* Copy actions */}
                      <div style={{ marginTop: 'auto', display: 'flex', flexDirection: 'column', gap: '6px' }}>
                        <button
                          type="button"
                          onClick={() => copyToClipboard(file.webViewLink, `link-${file.id}`)}
                          style={{
                            width: '100%',
                            padding: '7px 10px',
                            backgroundColor: copiedId === `link-${file.id}` ? 'rgba(16, 185, 129, 0.2)' : '#27272a',
                            border: '1px solid',
                            borderColor: copiedId === `link-${file.id}` ? '#10b981' : '#3f3f46',
                            borderRadius: '6px',
                            color: copiedId === `link-${file.id}` ? '#34d399' : '#d4d4d8',
                            fontSize: '0.78rem',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            gap: '6px',
                            cursor: 'pointer',
                          }}
                        >
                          <i className={copiedId === `link-${file.id}` ? 'fas fa-check' : 'fas fa-link'}></i>
                          {copiedId === `link-${file.id}` ? 'Drive Link Copied!' : 'Copy Drive Link'}
                        </button>

                        <button
                          type="button"
                          onClick={() => copyToClipboard(file.id, `id-${file.id}`)}
                          style={{
                            width: '100%',
                            padding: '5px 10px',
                            backgroundColor: 'transparent',
                            border: '1px dashed #3f3f46',
                            borderRadius: '6px',
                            color: copiedId === `id-${file.id}` ? '#34d399' : '#a1a1aa',
                            fontSize: '0.72rem',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            gap: '6px',
                            cursor: 'pointer',
                          }}
                        >
                          <i className="fas fa-fingerprint"></i>
                          {copiedId === `id-${file.id}` ? 'File ID Copied!' : 'Copy File ID'}
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </>
      )}

      {/* Preview Modal */}
      {previewFile && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            backgroundColor: 'rgba(0,0,0,0.85)',
            zIndex: 1000,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            padding: '24px',
          }}
          onClick={() => setPreviewFile(null)}
        >
          <div
            style={{
              backgroundColor: '#18181b',
              borderRadius: '14px',
              border: '1px solid #27272a',
              width: '100%',
              maxWidth: '850px',
              maxHeight: '90vh',
              overflow: 'hidden',
              display: 'flex',
              flexDirection: 'column',
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div
              style={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
                padding: '16px 20px',
                borderBottom: '1px solid #27272a',
              }}
            >
              <div style={{ fontWeight: 600, color: '#fff', fontSize: '1rem' }}>
                {previewFile.name}
              </div>
              <button
                type="button"
                onClick={() => setPreviewFile(null)}
                style={{
                  background: 'none',
                  border: 'none',
                  color: '#a1a1aa',
                  fontSize: '18px',
                  cursor: 'pointer',
                }}
              >
                &times;
              </button>
            </div>

            <div style={{ flex: 1, minHeight: '400px', backgroundColor: '#09090b', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
              {previewFile.mimeType.startsWith('image/') ? (
                <img
                  src={`https://drive.google.com/thumbnail?id=${previewFile.id}&sz=w1200`}
                  alt={previewFile.name}
                  style={{ maxWidth: '100%', maxHeight: '70vh', objectFit: 'contain' }}
                />
              ) : (
                <iframe
                  src={`https://drive.google.com/file/d/${previewFile.id}/preview`}
                  title={previewFile.name}
                  style={{ width: '100%', height: '65vh', border: 'none' }}
                />
              )}
            </div>

            <div
              style={{
                padding: '12px 20px',
                borderTop: '1px solid #27272a',
                display: 'flex',
                justifyContent: 'flex-end',
                gap: '10px',
              }}
            >
              <a
                href={previewFile.webViewLink}
                target="_blank"
                rel="noopener noreferrer"
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '6px',
                  padding: '8px 16px',
                  backgroundColor: '#27272a',
                  borderRadius: '6px',
                  color: '#fff',
                  textDecoration: 'none',
                  fontSize: '0.85rem',
                }}
              >
                <i className="fas fa-external-link-alt"></i>
                Open in Drive
              </a>
              <button
                type="button"
                onClick={() => setPreviewFile(null)}
                style={{
                  padding: '8px 16px',
                  backgroundColor: '#2563eb',
                  border: 'none',
                  borderRadius: '6px',
                  color: '#fff',
                  fontSize: '0.85rem',
                  cursor: 'pointer',
                }}
              >
                Done
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
