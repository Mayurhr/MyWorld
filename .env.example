# Admin Authentication
ADMIN_USERNAME=mayurhr
ADMIN_PASSWORD=your_secure_password_here
ADMIN_PASSWORD_HASH=
SESSION_SECRET=your_random_session_secret_here

# Cloudinary Media Storage (Server-Side Secrets Only - NEVER expose API_SECRET to client)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Firestore & Auth Configuration (provided via firebase-applet-config.json)

# Gemini AI API Key (for MAYU AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy Google Picker API Key (Optional; defaults to apiKey in firebase-applet-config.json)
VITE_GOOGLE_API_KEY=
